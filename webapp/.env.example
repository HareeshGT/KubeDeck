# Copy this file to .env and fill in your details.
# Never commit the real .env — it holds credentials.

# ── The box that has kubectl configured against your cluster ──
SSH_HOST=1.2.3.4
SSH_PORT=22
SSH_USER=ubuntu

# Use ONE of the two auth options below.
SSH_KEY_PATH=/path/to/your/private_key.pem
# SSH_PASSWORD=

# Optional: only needed if that box's kubeconfig has multiple contexts
# and you don't want kubectl's current-context.
KUBECONTEXT=

# ── Login for this dashboard itself ──
# Required. This page can delete pods and restart deployments, so it
# must always sit behind a login — pick a real password, not a
# placeholder, especially if you expose this beyond your home network.
APP_USERNAME=admin
APP_PASSWORD=change-me
